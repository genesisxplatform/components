{
  "name": "@gxpl/components",
  "version": "1.1.0",
  "description": "Custom components for the GX platform editor and published websites.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "style": "dist/components.css",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/Components/utils/index.d.ts",
      "import": "./dist/utils.mjs",
      "require": "./dist/utils.js"
    },
    "./sources": {
      "types": "./dist/sources.d.ts",
      "import": "./dist/sources.mjs",
      "require": "./dist/sources.js"
    },
    "./elements": {
      "types": "./dist/elements.d.ts",
      "node": {
        "import": "./dist/elements.node.mjs",
        "require": "./dist/elements.node.js"
      },
      "import": "./dist/elements.mjs",
      "require": "./dist/elements.js"
    },
    "./style/components.css": {
      "default": "./dist/components.css"
    }
  },
  "typesVersions": {
    "*": {
      "utils": [
        "./dist/Components/utils/index.d.ts"
      ],
      "sources": [
        "./dist/sources.d.ts"
      ],
      "elements": [
        "./dist/elements.d.ts"
      ]
    }
  },
  "scripts": {
    "test": "vitest run",
    "dev": "vite development",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run typecheck && rimraf ./dist",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "postbuild": "npm run check:sources && npm run check:elements",
    "check:sources": "node scripts/check-sources.mjs",
    "check:elements": "node scripts/check-elements.mjs",
    "prepublishOnly": "cross-env NODE_ENV=production npm run build"
  },
  "files": [
    "dist",
    "resources"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genesisxplatform/components.git"
  },
  "author": "arsen@momdesign.nyc",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/genesisxplatform/components/issues"
  },
  "homepage": "https://github.com/genesisxplatform/components#readme",
  "directories": {
    "lib": "dist"
  },
  "dependencies": {
    "classnames": "^2.5.1"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.16.0",
    "@splidejs/react-splide": "^0.7.12",
    "@tsconfig/node16": "^1.0.3",
    "@tsconfig/recommended": "^1.0.1",
    "@types/node": "^18.11.7",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^10.1.0",
    "jsdom": "^26.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rimraf": "^6.0.1",
    "sass": "^1.86.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2",
    "vite": "^6.2.5",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^3.2.7"
  }
}
